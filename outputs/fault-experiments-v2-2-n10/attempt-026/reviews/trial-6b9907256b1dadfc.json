nd-3beaadce814c2ac5"],"verdict":"met"},{"criterion":"Avoid presenting unsupported generic needs as validated market-demand evidence.","evidence_refs":["bnd-3beaadce814c2ac5","bnd-fec3a1acc50a0ab3"],"verdict":"not_met"}],"decision":"suspect","decision_reason":"provenance_assembly deterministically ranks the normalized rows by demand_score and record_id and assembles evidence source records, matching the upstream output shape. It also preserves the evidence_sources handoff. The concern is inherited: ranking unsupported demand-score rows converts weak background-like entries into provenance-ranked evidence, so the unit is not trusted for market-demand reporting even though its assembly behavior appears deterministic.","evidence_refs":["bnd-3beaadce814c2ac5","bnd-fec3a1acc50a0ab3"],"expand_helper_prefixes":[],"inspect_artifacts":[],"suspect_node_refs":["capture-attempt-000-eca7364d0d2c4aee:function:000014","capture-attempt-000-eca7364d0d2c4aee:state:000023"],"trust_level":null,"unit_id":"bnd-3beaadce814c2ac5"}]},"review_sha256":"sha256:d9b47f45d974dc13748553f3d21b10fea0f9cd0afb62b210996554f057a45a2c","schema_version":"corrected-four-instance-review-1","selected_suspect_boundary_id":"bnd-fec3a1acc50a0ab3","status":"complete","usage":{"calls":[{"cached_input_tokens":11648,"input_tokens":35692,"output_tokens":1430,"phase":"initial_review","purpose":"initial_review","reasoning_tokens":null,"total_tokens":null,"unavailable_fields":["reasoning_tokens","total_tokens"],"usage_status":"partially_unavailable"},{"cached_input_tokens":11648,"input_tokens":42995,"output_tokens":1567,"phase":"initial_review","purpose":"helper_expansion_follow_up","reasoning_tokens":null,"total_tokens":null,"unavailable_fields":["reasoning_tokens","total_tokens"],"usage_status":"partially_unavailable"}],"cumulative_actual_cached_input_tokens":23296,"cumulative_actual_input_tokens":78687,"cumulative_actual_output_tokens":2997,"cumulative_actual_reasoning_tokens":null,"cumulative_actual_total_tokens":nu