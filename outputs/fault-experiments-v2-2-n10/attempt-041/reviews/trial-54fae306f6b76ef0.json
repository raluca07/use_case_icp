 else {'need': '', 'unsupported': False}\n    recommendation = {'top_need': first_priority.get('need', ''), 'decision': 'prioritize' if first_priority.get('unsupported', False) else 'maintain'}\n    return retained_priorities_df, recommendation","state_type":"FunctionMapping","value_preview":null,"value_type":null},{"artifact_content":"demand_score                                                   9\nneed             isolate faulty execution branches before replay\nrecord_id                                                n06-r01\nsource_id                                                    s01\nsource_weight                                                  5\nName: 0, dtype: object","artifact_kind":"record","artifact_size":{"characters":354},"artifact_truncated":false,"artifact_value_sha256":"sha256:8c6569d8f9b04e8a3332d366886dbe247f39b467d1ce0cc5ab77498a28680e53","func_stack":["main","map_coverage,f6ac210b1a243537","for (_, row) in retained_df.iterrows():,#15"],"line_no":15,"names":["row"],"node_ref":"capture-attempt-000-e639e66fd73f8790:state:000016","node_sha256":"sha256:a2f4c6fd969c6ecc351317dd58459c3b2e34812833fb989c048b6bfca7772b4d","preview_truncated":false,"raw_id":"b1f4caaf-c9b8-40df-91ae-b4dd118a5cdb","raw_metadata":{"children":[],"etiq_metadata":{"columns":{"0":{"dtype":"object","is_id_feature":true,"number_of_nulls":0,"number_of_unique":5}},"id":"b1f4caaf-c9b8-40df-91ae-b4dd118a5cdb","object_id":"129785000565872","parent_function":{"dataset_function_arguments":["3981246c-2dbb-435a-8764-60fadc7ea38b"],"function_id":"41b78394-0e9c-4c7d-8234-11e9ddf35d4c","function_name":"retained_df.iterrows"},"table":{"number_of_columns":1,"number_of_rows":5},"variable_names":["row"]},"parent":[{"raw_id":"3981246c-2dbb-435a-8764-60fadc7ea38b","state_type":"DataframeState"}],"parent_func_mapping":{"dataset_function_arguments":["3981246c-2dbb-435a-8764-60fadc7ea38b"],"function_id":"41b78394-0e9c-4c7d-8234-11e9ddf35d4c","function_name":"retained_df.iterrows"},"source_node_ty