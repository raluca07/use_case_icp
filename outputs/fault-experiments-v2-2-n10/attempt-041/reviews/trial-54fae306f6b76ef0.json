_path":"generated/protocol_2_2/downstream_coverage_priority.py"},"raw_metadata_sha256":"sha256:c5f0e6d4e0d773cfd55c14362d6f9b2f6f421ce43336454075ae469f2fb5b0c1","scope_type":"FunctionDef","source":"\ndef prioritize(coverage_df, evidence_sources_df):\n    evidence_rows = evidence_sources_df.reindex(columns=['record_id', 'source_id', 'source_weight', 'rank']).fillna({'record_id': '', 'source_id': '', 'source_weight': 0, 'rank': 0}).to_dict(orient='records')\n    rank_by_record_id = {}\n    for evidence in evidence_rows:\n        rank_by_record_id[evidence.get('record_id', '')] = evidence.get('rank', 0)\n    priority_rows = []\n    for coverage in coverage_df.to_dict(orient='records'):\n        unsupported = coverage.get('coverage', '') != 'direct'\n        priority_rows.append({'record_id': coverage.get('record_id', ''), 'need': coverage.get('need', ''), 'capability_id': coverage.get('capability_id', ''), 'coverage': coverage.get('coverage', ''), 'unsupported': unsupported, 'upstream_rank': rank_by_record_id.get(coverage.get('record_id', ''), 0)})\n    ranked_rows = sorted(priority_rows, key=lambda record: (0 if record.get('unsupported', False) else 1, record.get('upstream_rank', 0), record.get('record_id', '')))\n    records = []\n    for (index, record) in enumerate(ranked_rows, start=1):\n        records.append({'priority_rank': index, 'record_id': record.get('record_id', ''), 'need': record.get('need', ''), 'capability_id': record.get('capability_id', ''), 'coverage': record.get('coverage', ''), 'unsupported': bool(record.get('unsupported', False)), 'upstream_rank': record.get('upstream_rank', 0)})\n    return pd.DataFrame(records)","state_type":"FunctionMapping","value_preview":null,"value_type":null},{"artifact_content":null,"artifact_kind":null,"artifact_size":null,"artifact_truncated":false,"artifact_value_sha256":null,"func_stack":["main","synthesize,336b7b9aeb7222a1"],"line_no":63,"names":["Assign"],"node_ref":"capture-attempt-000-e639e66fd73f8790:function:0