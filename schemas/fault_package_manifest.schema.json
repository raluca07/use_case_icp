{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/use-case-icp/fault-package-manifest.schema.json",
  "title": "Fault review package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "opaque_ids",
    "artifact_allowlist",
    "package_sha256",
    "common_base_sha256",
    "canonical_serialized_utf8_bytes",
    "estimated_input_tokens",
    "token_estimator",
    "separate_source_bundle",
    "source_history",
    "graph_node_serialization_policy",
    "history_items_withheld",
    "restricted_setup_records",
    "capability_flags"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "protocol_version", "protocol_content_hash"],
      "properties": {
        "protocol_id": {"const": "neurips-2026-workshop-fault-localisation"},
        "protocol_version": {"const": "1.3.1"},
        "protocol_content_hash": {"const": "sha256:c5af2acbe1aa7ab473efad4d2fc3adb4183edaadf23165831cfb7b052a3b1d9f"}
      }
    },
    "opaque_ids": {"type": "object"},
    "artifact_allowlist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "utf8_bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "utf8_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "package_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "common_base_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "canonical_serialized_utf8_bytes": {"type": "integer", "minimum": 0},
    "estimated_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "token_estimator": {"type": "string"},
    "separate_source_bundle": {"enum": ["included", "withheld"]},
    "source_history": {"enum": ["eligible", "withheld", "not_applicable"]},
    "graph_node_serialization_policy": {
      "const": "preserve_complete_visible_etiq_node_serialization_across_source_bundle_settings"
    },
    "history_items_withheld": {"type": "integer", "minimum": 0},
    "restricted_setup_records": {"const": "excluded"},
    "capability_flags": {"type": "object"}
  }
}
