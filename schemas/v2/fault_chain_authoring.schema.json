{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobs", "complexity_claims"],
  "properties": {
    "jobs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "pipeline"],
        "properties": {
          "job_id": {"type": "string"},
          "pipeline": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entry_file", "files", "review_boundaries"],
            "properties": {
              "entry_file": {"type": "string"},
              "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "content"], "properties": {"path": {"type": "string"}, "content": {"type": "string"}}}},
              "review_boundaries": {"type": "array", "minItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["boundary_id", "source_path", "qualified_function_name", "role", "expected_inputs", "expected_outputs"], "properties": {"boundary_id": {"type": "string", "minLength": 1}, "source_path": {"type": "string"}, "qualified_function_name": {"type": "string"}, "role": {"type": "string"}, "expected_inputs": {"type": "array", "items": {"type": "string"}}, "expected_outputs": {"type": "array", "items": {"type": "string"}}}}}
            }
          }
        }
      }
    },
    "complexity_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_boundary_count",
        "exact_handoff_count",
        "directly_executed_nested_helper_count",
        "has_join_or_aggregation"
      ],
      "properties": {
        "declared_boundary_count": {"type": "integer", "minimum": 0},
        "exact_handoff_count": {"type": "integer", "minimum": 0},
        "directly_executed_nested_helper_count": {"type": "integer", "minimum": 0},
        "has_join_or_aggregation": {"type": "boolean"}
      }
    }
  }
}
