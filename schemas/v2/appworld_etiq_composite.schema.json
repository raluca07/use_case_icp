{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rdr://schemas/v2/appworld_etiq_composite.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "graph_kind", "source_sha256", "layers", "nodes", "edges",
    "counts", "manifest"
  ],
  "properties": {
    "schema_version": {"const": "2.3.0"},
    "graph_kind": {"const": "appworld_etiq_composite"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appworld", "etiq"],
      "properties": {
        "appworld": {"type": "object"},
        "etiq": {"type": "object"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {"id": {"pattern": "^(aw|etiq):"}}
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["src", "kind", "dst"]
      }
    },
    "counts": {"type": "object"},
    "manifest": {
      "type": "object",
      "required": ["builder", "content_sha256", "node_count", "edge_count"]
    }
  }
}
