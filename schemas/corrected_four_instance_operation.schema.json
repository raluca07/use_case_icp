{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corrected_four_instance_operation.schema.json",
  "title": "Corrected four-instance reviewer operation",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "boundary_id", "prefixes"],
      "properties": {
        "operation": {"const": "helper_expansion"},
        "boundary_id": {"type": "string", "minLength": 1},
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "requests"],
      "properties": {
        "operation": {"const": "artifact_inspection"},
        "requests": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["node_ref", "inspection"],
            "properties": {
              "node_ref": {"type": "string", "minLength": 1},
              "inspection": {"enum": ["read", "describe", "full", "python"]},
              "start": {"type": "integer", "minimum": 0},
              "count": {"type": "integer", "minimum": 1},
              "columns": {"type": "array", "items": {"type": "string"}},
              "query": {"type": "string"},
              "include_raw_metadata": {"type": "boolean"},
              "code": {"type": "string", "maxLength": 2000}
            }
          }
        }
      }
    }
  ]
}
