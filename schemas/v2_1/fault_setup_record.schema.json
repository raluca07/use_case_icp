{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/use-case-icp/v2/fault-setup-record.schema.json",
  "title": "V2 Protocol 1.3.1 restricted setup record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_content_hash",
    "storage_classification",
    "record_kind",
    "setup_id",
    "job_ids",
    "payload",
    "setup_usage",
    "excluded_from_experimental_treatment_usage",
    "reviewer_visibility",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "protocol_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "storage_classification": {
      "const": "restricted_controller_only"
    },
    "record_kind": {
      "enum": [
        "preflight",
        "authoring",
        "stabilization_repair",
        "rejected_candidate",
        "reference_execution",
        "reference_oracle",
        "complexity_gate"
      ]
    },
    "setup_id": {
      "type": "string",
      "minLength": 8
    },
    "job_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload": {
      "type": "object"
    },
    "setup_usage": {
      "type": "object"
    },
    "excluded_from_experimental_treatment_usage": {
      "const": true
    },
    "reviewer_visibility": {
      "const": "forbidden"
    },
    "record_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
