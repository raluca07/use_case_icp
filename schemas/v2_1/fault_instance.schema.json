{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/use-case-icp/v2/fault-instance.schema.json",
  "title": "V2 frozen fault-localisation instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "protocol_version",
    "protocol_content_hash",
    "instance_id",
    "designation",
    "semantic_fault_class",
    "injection_operator",
    "target_job",
    "stage",
    "nested_helper",
    "ablation",
    "repair",
    "authoring_seed",
    "injection_seed",
    "reference_bundle_sha256",
    "mutant_bundle_sha256",
    "capture_set_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "protocol_id": {"const": "neurips-2026-workshop-fault-localisation-v2"},
    "protocol_version": {"const": "2.0.3"},
    "protocol_content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "instance_id": {"type": "string", "pattern": "^instance-[0-9]{2}$"},
    "designation": {"enum": ["faulty", "no_injection_control"]},
    "semantic_fault_class": {"type": ["string", "null"]},
    "injection_operator": {"type": ["string", "null"]},
    "target_job": {"type": ["string", "null"]},
    "stage": {"type": ["string", "null"]},
    "nested_helper": {"type": "boolean"},
    "ablation": {"type": "boolean"},
    "repair": {"type": "boolean"},
    "authoring_seed": {"type": "integer"},
    "injection_seed": {"type": ["integer", "null"]},
    "reference_bundle_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mutant_bundle_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "capture_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
