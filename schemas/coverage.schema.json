{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappings", "use_cases", "icp_traits", "gaps", "sufficient", "pipeline"],
  "properties": {
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["need", "capability", "status", "reason"],
        "properties": {
          "need": {"type": "string"},
          "capability": {"type": "string"},
          "status": {"enum": ["supported", "partial", "unsupported"]},
          "reason": {"type": "string"}
        }
      }
    },
    "use_cases": {"type": "array", "items": {"type": "string"}},
    "icp_traits": {"type": "array", "items": {"type": "string"}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "sufficient": {"type": "boolean"},
    "pipeline": {"$ref": "#/$defs/pipeline"}
  },
  "$defs": {
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_file", "files", "review_boundaries"],
      "properties": {
        "entry_file": {"type": "string"},
        "review_boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["function_name", "role", "expected_inputs", "expected_outputs"],
            "properties": {
              "function_name": {"type": "string"},
              "role": {"type": "string"},
              "expected_inputs": {"type": "array", "items": {"type": "string"}},
              "expected_outputs": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content"],
            "properties": {"path": {"type": "string"}, "content": {"type": "string"}}
          }
        }
      }
    }
  }
}
