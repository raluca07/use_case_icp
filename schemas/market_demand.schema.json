{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["needs", "workflows", "demand_signals", "assumptions", "gaps", "pipeline"],
  "properties": {
    "needs": {"type": "array", "items": {"type": "string"}},
    "workflows": {"type": "array", "items": {"type": "string"}},
    "demand_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audience",
          "job",
          "context",
          "pain",
          "trigger",
          "current_alternative",
          "consequence",
          "evidence",
          "source_url",
          "source_title",
          "source_type",
          "signal_type",
          "confidence",
          "limitations"
        ],
        "properties": {
          "audience": {"type": "string"},
          "job": {"type": "string"},
          "context": {"type": ["string", "null"]},
          "pain": {"type": "string"},
          "trigger": {"type": ["string", "null"]},
          "current_alternative": {"type": ["string", "null"]},
          "consequence": {"type": ["string", "null"]},
          "evidence": {"type": "string"},
          "source_url": {"type": "string"},
          "source_title": {"type": "string"},
          "source_type": {"type": "string"},
          "signal_type": {
            "enum": [
              "direct_voice",
              "observed_behavior",
              "operational_evidence",
              "quantitative_market_signal",
              "background"
            ]
          },
          "confidence": {"enum": ["high", "medium", "low"]},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "pipeline": {"$ref": "#/$defs/pipeline"}
  },
  "$defs": {
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_file", "files", "review_boundaries"],
      "properties": {
        "entry_file": {"type": "string"},
        "review_boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["function_name", "role", "expected_inputs", "expected_outputs"],
            "properties": {
              "function_name": {"type": "string"},
              "role": {"type": "string"},
              "expected_inputs": {"type": "array", "items": {"type": "string"}},
              "expected_outputs": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content"],
            "properties": {"path": {"type": "string"}, "content": {"type": "string"}}
          }
        }
      }
    }
  }
}
