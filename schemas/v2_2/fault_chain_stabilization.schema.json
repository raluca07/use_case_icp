{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "replacement_source", "boundary_relinks"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "replacement_source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "content": {"type": "string"}
        }
      }
    },
    "boundary_relinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boundary_id", "qualified_function_name"],
        "properties": {
          "boundary_id": {"type": "string", "minLength": 1},
          "qualified_function_name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          }
        }
      }
    }
  }
}
